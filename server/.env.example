# Auth backend configuration example
#
# Copy to a local file (e.g. .env) and export the variables before running
# the server. Values shown are non-secret defaults; override in your
# environment. Never commit real secrets.

# Host:port the HTTP server binds to.
AUTH_LISTEN_ADDR=:8080

# Filesystem path of the SQLite database file.
AUTH_DB_PATH=auth.db

# Short-lived access token lifetime (Go duration, e.g. 15m).
AUTH_ACCESS_TOKEN_TTL=15m

# Refresh/session lifetime. Capped at 30 days (docs/AUTH.md).
AUTH_REFRESH_TOKEN_TTL=720h

# bcrypt cost for password hashing (4-31).
AUTH_BCRYPT_COST=12

# Admin token gating administrative endpoints (/api/server/start and
# /api/admin/hwid/*). When unset, all admin endpoints are disabled (404).
# Generate a long random value and keep it secret.
AUTH_ADMIN_TOKEN=

# Path of the server-control script invoked by POST /api/server/start.
AUTH_PTERO_SCRIPT=scripts/ptero_control.py
